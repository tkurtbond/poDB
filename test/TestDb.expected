  missing blob=0  err=3 msg=no such column name
mock: step
  id=2 name=[] type=0 last=0
  missing int=0  err=3 msg=no such column name
  missing text=[]  err=3 msg=no such column name
  missing type=0  err=3 msg=no such column name
  name in 3 characters=[]
  IsNull name=TRUE id=FALSE BlobByName name=0
  missing IsNull=TRUE  err=3 msg=no such column name
  missing blob=0  err=3 msg=no such column name
mock: step
  err=0
mock: finalize

== Exec and transactions
Begin: mock: prepare BEGIN
mock: step
mock: finalize
TRUE  err=0
Commit: mock: prepare COMMIT
mock: step
mock: finalize
TRUE  err=0
Rollback: mock: prepare ROLLBACK
mock: step
mock: finalize
TRUE  err=0
Exec FAIL: mock: prepare FAIL
FALSE  err=2 msg=mock: prepare failed
Exec STEPFAIL: mock: prepare STEPFAIL
mock: step
mock: finalize
FALSE  err=2 msg=mock: step failed
Exec bad placeholders: FALSE  err=2 msg=mock: bad placeholders
mock: prepare CREATE TABLE t (a INTEGER)
mock: step
mock: finalize
Exec CREATE: TRUE  err=0
mock: prepare DELETE
Changes=3
mock: finalize
conn.Changes=3
